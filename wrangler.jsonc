{
  "name": "covet",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "main": "worker.js",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "senseistudios.com/covet*", "zone_name": "senseistudios.com" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/covet", "/covet/*"]
  }
}
